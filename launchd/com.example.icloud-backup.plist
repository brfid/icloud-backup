<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Copy to ~/Library/LaunchAgents/, set your own Label, the script path,
     and (optionally) ICLOUD_BACKUP_CONFIG, then load with:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/<label>.plist
     Runs the backup once daily at 03:00; a missed run fires on next wake. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.icloud-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>/Users/USERNAME/src/icloud-backup/icloud_backup.py</string>
        <string>run</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/icloud-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/icloud-backup.log</string>
</dict>
</plist>
